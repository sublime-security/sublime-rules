name: "Attachment: BEC content within compressed archive"
description: "Flags inbound messages carrying gzip attachments that, once expanded, contain an email file whose thread body text is classified by the NLU model as business email compromise with high confidence."
type: "rule"
severity: "medium"
source: |
  type.inbound
  and any(filter(attachments, .file_type == "gz"),
          any(file.expand_archives(.).files,
               any(ml.nlu_classifier(file.parse_eml(.).body.current_thread.text
                      ).intents,
                      .name == "bec" and .confidence == "high"
              )
          )
  )
attack_types:
  - "BEC/Fraud"
tactics_and_techniques:
  - "Social engineering"
detection_methods:
  - "Archive analysis"
  - "File analysis"
  - "Natural Language Understanding"
